# Copy to .env.local. Only PUBLIC values belong here.
# All API secrets (OpenAI, Resend, Supabase service key) live in
# Supabase → Edge Functions → Secrets and are used by supabase/functions/*.

# Supabase (Project Settings → API Keys → publishable)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Simple passcode for the city panel (/panel)
PANEL_PASSCODE=hackyeah
