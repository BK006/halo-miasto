# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=

# Resend (resend.com) – in test mode it can only deliver to your own address
RESEND_API_KEY=
EMAIL_FROM=Zglos to <onboarding@resend.dev>
# Every report e-mail is redirected here during the demo
DEMO_EMAIL_TO=

# Simple passcode for the city panel (/panel)
PANEL_PASSCODE=hackyeah
